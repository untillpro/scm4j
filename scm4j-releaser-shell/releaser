#!/bin/sh

set -e

info() {
	# Print informational messages in bold green to stderr.
	printf '\033[1;32m%s\033[0m\n' "$*" >&2
}

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
SCM4J_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd -P)
LIBS="$SCM4J_ROOT/scm4j-releaser/build/libs"

commit=$(git -C "$SCM4J_ROOT" rev-parse HEAD)
if tag=$(git -C "$SCM4J_ROOT" describe --tags --exact-match HEAD 2>/dev/null); then
	info "Run scm4j-releaser from commit $commit, tag $tag"
else
	info "Run scm4j-releaser from commit $commit"
fi

info "Build scm4j-releaser from $SCM4J_ROOT..."
"$SCM4J_ROOT/gradlew" -p "$SCM4J_ROOT" :scm4j-releaser:fatJar

jar="$LIBS/fat-scm4j-releaser.jar"
if [ ! -f "$jar" ]; then
	info "Unable to find the scm4j-releaser fat JAR in $LIBS"
	exit 1
fi

exec java -cp "$jar" -Djava.util.concurrent.ForkJoinPool.common.parallelism=8 org.scm4j.releaser.cli.CLI "$@"
